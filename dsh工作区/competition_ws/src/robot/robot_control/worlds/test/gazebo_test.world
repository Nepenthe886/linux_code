<?xml version="1.0" ?>
<!--
  robot_control 自带的最小测试世界（Gazebo Classic 11 / SDF 1.6）
  =================================================================
  用途：当比赛地图包 zhirong_maps 还不存在时，gazebo.launch.py 回退到这里，
        先把「spawn 机器人 + /cmd_vel -> /odom -> TF」链路跑通。
  内容：太阳光 + 无限地面，没有障碍物；物理步长 1 ms，实时率 1.0。
        地面用 Gazebo 自带模型 model://ground_plane，依赖 GAZEBO_MODEL_PATH
        （`source tools/gazebo_env.sh` 已设置）。
  用法：ros2 launch robot_control gazebo.launch.py world:=<本文件绝对路径>
-->
<sdf version="1.6">
  <world name="robot_test_world">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.80 0.90 1</background>
      <shadows>false</shadows>
    </scene>
  </world>
</sdf>
