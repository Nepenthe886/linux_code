<?xml version="1.0"?>
<!--
  robot_description 的 Gazebo 模型目录（仅用于 model:// 网格解析）
  ---------------------------------------------------------------
  URDF 里 LiDAR 网格写成 package://robot_description/meshes/*.stl，
  spawn_entity.py 的 -package_to_model 会把它转成
  model://robot_description/meshes/*.stl，Gazebo 通过 GAZEBO_MODEL_PATH
  找到本目录下的 meshes/（内容与 robot_description/meshes/ 一致）。

  这样做的好处：URDF/SDF 中的网格 URI 始终是纯 ASCII 的 model://，
  不依赖工作区绝对路径，避免中文/空格路径在 urdf->sdf 转换中被破坏。
-->
<model>
  <name>robot_description</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Zhirong Cup Team</name>
    <email>nepenthe@example.com</email>
  </author>
  <description>robot_description meshes for Gazebo model:// resolution</description>
</model>
