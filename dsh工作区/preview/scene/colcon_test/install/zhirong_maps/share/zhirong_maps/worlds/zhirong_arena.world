<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="zhirong_arena">
    <!-- 反恐搜救赛项比赛场地：16 个 1.25 m 单元格（5 m x 5 m 范围，行 A 北->D 南、列 1 西->4 东）；x 东 / y 北 / 原点=场地中心 -->
    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.76 0.83 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- 物理：固定 1 ms 步长，1 kHz 更新 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <gravity>0 0 -9.8</gravity>

    <!-- 太阳光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.88 0.85 0.78 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.55 0.35 -0.75</direction>
    </light>

    <!-- GUI 相机预设：正俯视、与图 2 同方向（+x 东 / +y 北） -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 6.0 0 1.5708 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- ============ 地面 / 场地 / 网格 / 红边界 ============ -->
    <include>
      <uri>model://ground_8x8</uri>
      <name>ground</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://arena_floor</uri>
      <name>arena_floor</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://cell_grid</uri>
      <name>cell_grid</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://boundary_red</uri>
      <name>boundary_red</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ============ 分区地面 ============ -->
    <include>
      <uri>model://zone_yellow</uri>
      <name>zone_yellow</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://zone_orange_ramp1</uri>
      <name>zone_orange_ramp_1</name>
      <pose>0.98 0.254 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://zone_orange_ramp2</uri>
      <name>zone_orange_ramp_2</name>
      <pose>-0.65 -1.23 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://zone_red</uri>
      <name>zone_red</name>
      <pose>-0.31 -2.085 0 0 0 0</pose>
    </include>

    <!-- ============ 分块布局：墙体 / 障碍 / 斜坡 ============ -->
