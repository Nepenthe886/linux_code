prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/common3

Name: Ignition common events
Description: A set of common events classes for robot applications
Version: ignition-cmake2 >= 1.1 3.14.0
Requires: ignition-math6 ignition-common3 = 3.14.0
Requires.private: 
Libs: -L${libdir} -lignition-common3-events 
Libs.private: 
CFLags: -I${includedir} 
