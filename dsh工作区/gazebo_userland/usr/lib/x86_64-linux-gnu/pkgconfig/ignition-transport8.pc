prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/transport8

Name: Ignition transport
Description: A set of transport classes for robot applications
Version: 8.2.1
Requires: ignition-cmake2 >= 1.1 protobuf >= 3 uuid ignition-msgs5
Requires.private: libzmq >= 4
Libs: -L${libdir} -lignition-transport8 
Libs.private: 
CFlags: -I${includedir} -std=c++17
