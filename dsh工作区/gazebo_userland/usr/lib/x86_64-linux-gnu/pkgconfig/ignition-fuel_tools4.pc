prefix=${pcfiledir}/../../../
libdir=${prefix}/lib/x86_64-linux-gnu
includedir=${prefix}/include/ignition/fuel_tools4

Name: Ignition fuel_tools
Description: A set of fuel_tools classes for robot applications
Version: 4.4.0
Requires: ignition-cmake2 >= 1.1 
Requires.private: tinyxml2 libcurl >=  jsoncpp yaml-0.1 libzip ignition-common3 ignition-math6 ignition-msgs5
Libs: -L${libdir} -lignition-fuel_tools4 
Libs.private: 
CFlags: -I${includedir} -std=c++17
