    </collision>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.17 -0.17 -0.175" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="20.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ======================= Livox Mid-360 =======================
       Link frame: centre of the mounting face (top of the body).
       Device: 65 x 65 x 60 mm, weight 265 g.
       Mounting plate 6 mm + device 60 mm -> top of lidar at z = 0.406.
  =============================================================== -->
  <link name="livox_mid360_link">
    <inertial>
      <origin xyz="0 0 0.036" rpy="0 0 0"/>
      <mass value="0.265"/>
      <!-- box 0.065 x 0.065 x 0.060 -->
      <inertia ixx="0.0001727" ixy="0.0" ixz="0.0"
               iyy="0.0001727" iyz="0.0" izz="0.0001866"/>
    </inertial>

    <!-- adapter plate on the body top -->
    <visual>
      <origin xyz="0 0 0.003" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.006"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>

    <!-- lower housing -->
    <visual>
      <origin xyz="0 0 0.019" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.065 0.026"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>

    <!-- 360 deg optical window band -->
    <visual>
      <origin xyz="0 0 0.044" rpy="0 0 0"/>
      <geometry>
        <box size="0.062 0.062 0.024"/>
      </geometry>
      <material name="lidar_glass"/>
    </visual>

    <!-- top cap -->
    <visual>
      <origin xyz="0 0 0.061" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.065 0.010"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.033" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.065 0.066"/>
      </geometry>
    </collision>
  </link>
  <joint name="livox_mid360_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_mid360_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ======================= depth camera =======================
       Intel RealSense D435i style: 90 x 25 x 25 mm.
       Body centre at x = 0.263 (back face 0.2505), z = 0.270.
       camera_link  : x forward, y left, z up (body axes)
       camera_optical_frame : z forward, x right, y down (REP-103)
  =============================================================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.09"/>
      <!-- box 0.025 x 0.090 x 0.025 -->
      <inertia ixx="0.0000654" ixy="0.0" ixz="0.0"
               iyy="0.0000094" iyz="0.0" izz="0.0000654"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>

    <!-- dark front glass -->
    <visual>
      <origin xyz="0.0135 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.074 0.018"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>

    <!-- three lenses: left IR / RGB / right IR (dark ring + blue glass) -->
    <visual>
      <origin xyz="0.0160 -0.031 0" rpy="0 1.57079632679 0"/>
      <geometry>
