  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right_link"/>
    <origin xyz="-0.07 -0.07 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ======================= Livox Mid-360 =======================
       Link frame: centre of the mounting face (top of the body).
       Device: 65 x 65 x 60 mm, weight 265 g.
       Open-source STL device 60 mm -> top of lidar at z = 0.330.
  =============================================================== -->
  <link name="livox_mid360_link">
    <inertial>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <mass value="0.265"/>
      <!-- box approximation of the 65 x 65 x 60 mm device -->
      <inertia ixx="0.0001727" ixy="0.0" ixz="0.0"
               iyy="0.0001727" iyz="0.0" izz="0.0001866"/>
    </inertial>

    <!-- Open-source Livox Mid-360 STL (MIT). The model is split by material:
         silver heat-sink base, blue dome, black top cap. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/mid360_base.stl"/>
      </geometry>
      <material name="lidar_silver"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/mid360_dome.stl"/>
      </geometry>
      <material name="lidar_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/mid360_top.stl"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.030" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.065 0.060"/>
      </geometry>
    </collision>
  </link>
  <joint name="livox_mid360_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_mid360_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- ======================= depth camera =======================
       Intel RealSense D435i style: 90 x 25 x 25 mm.
       Body centre at x = 0.113 (back face 0.1005), z = 0.185.
       camera_link  : x forward, y left, z up (body axes)
       camera_optical_frame : z forward, x right, y down (REP-103)
  =============================================================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.09"/>
      <!-- box 0.025 x 0.090 x 0.025 -->
      <inertia ixx="0.0000654" ixy="0.0" ixz="0.0"
               iyy="0.0000094" iyz="0.0" izz="0.0000654"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>

    <!-- dark front glass -->
    <visual>
      <origin xyz="0.0135 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.002 0.074 0.018"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>

    <!-- three lenses: left IR / RGB / right IR (dark ring + blue glass) -->
    <visual>
      <origin xyz="0.0160 -0.031 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0070" length="0.003"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <visual>
      <origin xyz="0.0170 -0.031 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0050" length="0.003"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>
    <visual>
      <origin xyz="0.0160 0.000 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0070" length="0.003"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <visual>
      <origin xyz="0.0170 0.000 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0050" length="0.003"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>
    <visual>
      <origin xyz="0.0160 0.031 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0070" length="0.003"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <visual>
      <origin xyz="0.0170 0.031 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.0050" length="0.003"/>
      </geometry>
      <material name="lens_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.113 0 0.015" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.0185 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- ==================================================================
       Gazebo Classic 11 集成（仅 Gazebo 使用，不影响 RViz 显示结构）
       ··································································
       插件（ModelPlugin，写在 robot 级 <gazebo> 里）：
         * libgazebo_ros_planar_move.so
             速度级平面运动：订阅 /cmd_vel(Twist)，发布 /odom 与
             TF odom->base_footprint。参数名已按 gazebo_ros 3.9 插件源码 /
             gazebo_plugins 自带 demo world 核实：
             update_rate / publish_rate / publish_odom / publish_odom_tf /
             odometry_frame / robot_base_frame / covariance_x|y|yaw。
         * libgazebo_ros_joint_state_publisher.so
             发布四个轮关节的 /joint_states（update_rate + 每个 joint_name）。
       注意：libgazebo_ros_init.so / libgazebo_ros_factory.so 是 SystemPlugin，
       必须由 gzserver 命令行 -s 加载（见 launch/gazebo.launch.py），不能写在这里。
       ================================================================== -->

  <!-- 材质：Gazebo 不解析 URDF 顶部的 <material> 名字，需要逐 link 指定。
       self_collide 保持 false（与 URDF 默认一致），避免轮子与底盘自碰撞。 -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- 四个麦轮：planar_move 直接设置车体速度，轮子碰撞体不应与地面大力摩擦，
       否则接触约束会和速度指令打架产生抖动/漂移；统一调低摩擦系数。
       轮子由关节状态发布器以 passive 关节形式驱动，不含电机模型。 -->
  <gazebo reference="wheel_front_left_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="wheel_front_right_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="wheel_rear_left_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="wheel_rear_right_link">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="livox_mid360_link">
    <material>Gazebo/DarkGrey</material>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="camera_link">
    <material>Gazebo/FlatBlack</material>
    <self_collide>false</self_collide>
  </gazebo>
  <gazebo reference="camera_optical_frame">
    <self_collide>false</self_collide>
  </gazebo>

  <!-- 底盘速度级运动 + 里程计 / TF（odom -> base_footprint）。
       /wheel_cmd 在本模式下不参与：teleop 发的 /cmd_vel 直接驱动车体。 -->
  <gazebo>
    <plugin name="gazebo_ros_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
      <publish_rate>50.0</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <!-- 轮关节状态：robot_state_publisher 需要 /joint_states 才能生成轮子 TF -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
      <joint_name>wheel_front_left_joint</joint_name>
      <joint_name>wheel_front_right_joint</joint_name>
      <joint_name>wheel_rear_left_joint</joint_name>
      <joint_name>wheel_rear_right_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
