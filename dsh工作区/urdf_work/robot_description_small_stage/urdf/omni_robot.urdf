<?xml version="1.0"?>
<!--
  Zhirong Cup omnidirectional robot - minimalist primitive-geometry URDF
  ======================================================================
  Coordinate convention:
    +X : forward (depth camera side)
    +Y : left
    +Z : up
    base_footprint : ground projection of the robot centre
    base_link      : geometric centre of the cylindrical body

  Key dimensions (metres):
    body cylinder          radius 0.100, height 0.200
    body bottom / top      z = 0.070 / 0.270
    wheel                  radius 0.030, width 0.020
    wheel centres          x = +-0.070, y = +-0.070, z = 0.030
    Livox Mid-360          65 x 65 x 60 mm, on body top centre
    depth camera (D435i)   90 x 25 x 25 mm, front face of body
  ======================================================================
-->
<robot name="zhirong_omni_robot">

  <!-- ======================= materials ======================= -->
  <material name="body_gray">
    <color rgba="0.76 0.79 0.83 1.0"/>
  </material>
  <material name="accent_orange">
    <color rgba="0.95 0.45 0.10 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.09 0.09 0.10 1.0"/>
  </material>
  <material name="hub_gray">
    <color rgba="0.45 0.47 0.50 1.0"/>
  </material>
  <material name="wheel_plate">
    <color rgba="0.22 0.23 0.25 1.0"/>
  </material>
  <material name="roller_gray">
    <color rgba="0.40 0.41 0.44 1.0"/>
  </material>
  <material name="lidar_black">
    <color rgba="0.05 0.05 0.06 1.0"/>
  </material>
  <material name="lidar_blue">
    <color rgba="0.04 0.28 0.60 1.0"/>
  </material>
  <material name="lidar_silver">
    <color rgba="0.68 0.70 0.73 1.0"/>
  </material>
  <material name="camera_dark">
    <color rgba="0.15 0.16 0.18 1.0"/>
  </material>
  <material name="lens_blue">
    <color rgba="0.08 0.20 0.50 1.0"/>
  </material>

  <!-- ======================= chassis ======================= -->
  <!-- base_footprint 是地面投影参考系，故意不给 <inertial>：
       1) robot_state_publisher 用 KDL 解析 URDF，KDL 不支持「根 link 带惯性」
          （会打印 The root link base_footprint has an inertia ... 警告）；
       2) Gazebo Classic 的 URDF->SDF 转换会把固定关节子 link（base_link）的
          质量/惯性 lumped 进根 link，base_footprint 没惯性也能正常仿真
          （已实测 spawn 无报错、落地高度正确）。
       这也是 URDF/RViz 侧的既有约定，不要为了 Gazebo 在这里加惯性。 -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <!-- solid cylinder: Ixx=Iyy=m(3r^2+h^2)/12, Izz=m r^2/2 -->
      <inertia ixx="0.0070" ixy="0.0" ixz="0.0"
               iyy="0.0070" iyz="0.0" izz="0.0060"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.20"/>
      </geometry>
      <material name="body_gray"/>
    </visual>

    <!-- thin orange accent band, purely cosmetic -->
    <visual>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1008" length="0.02"/>
      </geometry>
      <material name="accent_orange"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.20"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
  </joint>

  <!-- ======================= wheels =======================
       Four mecanum-style wheels, X layout (45 deg positions).
       Wheel axle is parallel to Y, so every wheel uses axis "0 1 0".
       For mecanum kinematics the four wheel speeds are the usual
       w_fl = ( vx - vy - (lx+ly)wz ) / r  ... etc.
  ======================================================== -->

  <!-- front left -->
  <link name="wheel_front_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <!-- cylinder axis along Y -->
      <inertia ixx="0.00003875" ixy="0.0" ixz="0.0"
               iyy="0.00006750" iyz="0.0" izz="0.00003875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.018"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 -0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.022"/>
      </geometry>
      <material name="hub_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.024" rpy="-1.57079633 0 -0.78539816"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.0154269 0 -0.01838507" rpy="-1.09896365 0 -0.65369072"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02363539 0 -0.00416756" rpy="-0.80047729 0 -0.17193371"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02078461 0 0.012" rpy="-0.91173829 0 0.46364761"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.00820848 0 0.02255262" rpy="-1.32652972 0 0.75431697"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.00820848 0 0.02255262" rpy="-1.81506293 0 0.75431697"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02078461 0 0.012" rpy="-2.22985436 0 0.46364761"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02363539 0 -0.00416756" rpy="-2.34111536 0 -0.17193371"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.0154269 0 -0.01838507" rpy="-2.042629 0 -0.65369072"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left_link"/>
    <origin xyz="0.07 0.07 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- front right -->
  <link name="wheel_front_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <!-- cylinder axis along Y -->
      <inertia ixx="0.00003875" ixy="0.0" ixz="0.0"
               iyy="0.00006750" iyz="0.0" izz="0.00003875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.018"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 -0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.022"/>
      </geometry>
      <material name="hub_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.024" rpy="-1.57079633 0 -2.35619449"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.0154269 0 -0.01838507" rpy="-1.09896365 0 -2.48790193"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02363539 0 -0.00416756" rpy="-0.80047729 0 -2.96965894"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02078461 0 0.012" rpy="-0.91173829 0 2.67794504"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.00820848 0 0.02255262" rpy="-1.32652972 0 2.38727568"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.00820848 0 0.02255262" rpy="-1.81506293 0 2.38727568"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02078461 0 0.012" rpy="-2.22985436 0 2.67794504"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02363539 0 -0.00416756" rpy="-2.34111536 0 -2.96965894"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.0154269 0 -0.01838507" rpy="-2.042629 0 -2.48790193"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right_link"/>
    <origin xyz="0.07 -0.07 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- rear left -->
  <link name="wheel_rear_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <!-- cylinder axis along Y -->
      <inertia ixx="0.00003875" ixy="0.0" ixz="0.0"
               iyy="0.00006750" iyz="0.0" izz="0.00003875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.018"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 -0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.022"/>
      </geometry>
      <material name="hub_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.024" rpy="-1.57079633 0 -0.78539816"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.0154269 0 -0.01838507" rpy="-1.09896365 0 -0.65369072"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02363539 0 -0.00416756" rpy="-0.80047729 0 -0.17193371"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.02078461 0 0.012" rpy="-0.91173829 0 0.46364761"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="0.00820848 0 0.02255262" rpy="-1.32652972 0 0.75431697"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.00820848 0 0.02255262" rpy="-1.81506293 0 0.75431697"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02078461 0 0.012" rpy="-2.22985436 0 0.46364761"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.02363539 0 -0.00416756" rpy="-2.34111536 0 -0.17193371"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <visual>
      <origin xyz="-0.0154269 0 -0.01838507" rpy="-2.042629 0 -0.65369072"/>
      <geometry>
        <cylinder radius="0.005" length="0.014"/>
      </geometry>
      <material name="roller_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.020"/>
      </geometry>
    </collision>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left_link"/>
    <origin xyz="-0.07 0.07 -0.14" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="30.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- rear right -->
  <link name="wheel_rear_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <!-- cylinder axis along Y -->
      <inertia ixx="0.00003875" ixy="0.0" ixz="0.0"
               iyy="0.00006750" iyz="0.0" izz="0.00003875"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.018"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 -0.009 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.023" length="0.0015"/>
      </geometry>
      <material name="wheel_plate"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079633 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.022"/>
      </geometry>
      <material name="hub_gray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.024" rpy="-1.57079633 0 -2.35619449"/>
