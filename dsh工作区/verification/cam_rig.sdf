<?xml version="1.0"?>
<!-- 验证用俯瞰相机：随 gz model -f 动态 spawn，经 gazebo_ros_camera 发布 ROS 图像话题 -->
<sdf version="1.6">
  <model name="overview_cam">
    <static>true</static>
    <link name="link">
      <visual name="vis"><geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
      <sensor name="cam" type="camera">
        <update_rate>2</update_rate>
        <camera>
          <horizontal_fov>1.15</horizontal_fov>
          <image><width>1600</width><height>1000</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>200</far></clip>
        </camera>
        <plugin name="camera_ros" filename="libgazebo_ros_camera.so">
          <ros><namespace>/overview_cam</namespace></ros>
          <camera_name>image</camera_name>
          <frame_name>overview_cam_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
